{
  "_note": "Every tunable lives here so the adaptive engine, readiness thresholds and planner can be changed without touching code.",

  "sections": [
    { "id": "aptitude",      "name": "Aptitude",           "weight": 0.25 },
    { "id": "logical",       "name": "Logical Reasoning",  "weight": 0.20 },
    { "id": "coding",        "name": "Coding",             "weight": 0.25 },
    { "id": "communication", "name": "Communication",      "weight": 0.15 },
    { "id": "domain",        "name": "Domain Knowledge",   "weight": 0.15 }
  ],

  "domains": ["CS/IT", "ECE", "Mechanical", "Commerce"],

  "readinessThresholds": {
    "beginnerMax": 45,
    "intermediateMax": 75,
    "_note": "score < 45 -> Beginner, 45..74.99 -> Intermediate, >= 75 -> Advanced"
  },

  "placementReadinessWeights": {
    "assessment": 0.45,
    "mockTest": 0.20,
    "mockInterview": 0.15,
    "resume": 0.10,
    "courseCompletion": 0.10
  },

  "adaptive": {
    "model": "elo",
    "initialAbility": 0.5,
    "kFactor": 0.35,
    "abilityFloor": 0.0,
    "abilityCeil": 1.0,
    "_note": "ability in [0,1] maps to easy/medium/hard at 0.33 / 0.66 cut points"
  },

  "assessmentDefaults": {
    "diagnosticQuestionCount": 20,
    "customQuestionCount": 10,
    "defaultTimeLimitSec": 90,
    "negativeMarking": 0.0
  },

  "skillGap": {
    "accuracyTarget": 0.75,
    "minTopicAttempts": 1,
    "maxRecommendations": 4
  },

  "spacedRepetition": { "intervalsDays": [1, 3, 7, 16, 35] },

  "planner": {
    "hoursPerWeek": 8,
    "maxTasksPerWeek": 5,
    "rescheduleMissedAfterDays": 0,
    "_note": "rescheduleMissedAfterDays = 0 means overdue tasks re-plan as soon as the planner is opened"
  },

  "mentorRisk": {
    "decliningTrendDrop": 5,
    "inactiveDays": 10,
    "lowReadiness": 45
  },

  "gamification": { "enabled": true, "weeklyGoalXp": 300 }
}
